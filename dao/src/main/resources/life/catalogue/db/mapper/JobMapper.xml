<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="life.catalogue.db.mapper.JobMapper">

  <sql id="SELECT">
    j.key,
    j.job_class,
    j.lane,
    j.status,
    j.step,
    j.priority,
    j.dataset_key,
    j.sector_key,
    j.created_by,
    j.created,
    j.started,
    j.finished,
    j.error,
    j.params,
    j.result_md5,
    j.result_size,
    j.result_deleted
  </sql>

  <sql id="COLS">
    key,
    job_class,
    lane,
    status,
    step,
    priority,
    dataset_key,
    sector_key,
    created_by,
    created,
    started,
    finished,
    error,
    params,
    result_md5,
    result_size,
    result_deleted
  </sql>

  <sql id="PROPS">
    #{key},
    #{job},
    #{lane}::JOBLANE,
    #{status}::JOBSTATUS,
    #{step},
    #{priority}::JOBPRIORITY,
    #{datasetKey},
    #{sectorKey},
    #{createdBy},
    #{created},
    #{started},
    #{finished},
    #{error},
    #{params, typeHandler=life.catalogue.db.type2.JsonNodeHandler}::jsonb,
    #{resultMd5},
    #{resultSize},
    #{resultDeleted}
  </sql>

  <sql id="FROM">
    job j
  </sql>

  <sql id="WHERE">
    <where>
      <if test="req.key != null">AND j.key = #{req.key}</if>
      <if test="req.datasetKey != null">AND j.dataset_key = #{req.datasetKey}</if>
      <if test="req.sectorKey != null">AND j.sector_key = #{req.sectorKey}</if>
      <if test="req.createdBy != null">AND j.created_by = #{req.createdBy}</if>
      <if test="req.priority != null">AND j.priority = #{req.priority}::JOBPRIORITY</if>
      <if test="req.createdAfter != null">AND j.created &gt;= #{req.createdAfter}</if>
      <if test="req.createdBefore != null">AND j.created &lt;= #{req.createdBefore}</if>
      <!-- matches the lower(job_class) index -->
      <if test="req.job != null and !req.job.isEmpty()">
        AND lower(j.job_class) IN <foreach item="jc" collection="req.job" open="(" separator="," close=")">lower(#{jc})</foreach>
      </if>
      <if test="req.lane != null and !req.lane.isEmpty()">
        AND j.lane IN <foreach item="ln" collection="req.lane" open="(" separator="," close=")">#{ln}::JOBLANE</foreach>
      </if>
      <if test="req.status != null and !req.status.isEmpty()">
        AND j.status IN <foreach item="st" collection="req.status" open="(" separator="," close=")">#{st}::JOBSTATUS</foreach>
      </if>
      <!--
        Only imports and exports carry a data format and they keep it in their own satellite table -
        the source archive format for an import, the target format for an export. Filtering on it
        therefore also narrows the result to those two kinds of job. Both branches are keyed back to
        the job, so this stays a semi join and never duplicates rows.
        Neither format column is indexed - DATAFORMAT has too few values to be worth it - so the
        import branch costs one scan of dataset_import, hashed once per query.
      -->
      <if test="req.format != null">
        AND j.key IN (
          SELECT di.job_key FROM dataset_import di WHERE di.job_key IS NOT NULL AND di.format = #{req.format}::DATAFORMAT
          UNION ALL
          SELECT de.key FROM dataset_export de WHERE de.format = #{req.format}::DATAFORMAT
        )
      </if>
    </where>
  </sql>

  <resultMap id="jobResultMap" type="JobInfo" autoMapping="true">
    <id property="key" column="key"/>
    <result property="job" column="job_class"/>
    <result property="params" column="params" typeHandler="life.catalogue.db.type2.JsonNodeHandler"/>
  </resultMap>


  <select id="get" resultMap="jobResultMap">
    SELECT <include refid="SELECT"/>
    FROM <include refid="FROM"/>
    WHERE key = #{key}
  </select>

  <select id="exists" resultType="boolean">
    SELECT exists(
      SELECT TRUE FROM job WHERE key = #{key}
    )
  </select>

  <insert id="create" parameterType="JobInfo">
    INSERT INTO job (<include refid="COLS"/>)
    VALUES (<include refid="PROPS"/>)
  </insert>

  <update id="update" parameterType="JobInfo">
    UPDATE job
    SET (status, step, started, finished, error, result_md5, result_size, result_deleted)
      = (#{status}::JOBSTATUS, #{step}, #{started}, #{finished}, #{error}, #{resultMd5}, #{resultSize}, #{resultDeleted})
    WHERE key = #{key}
  </update>

  <delete id="delete">
    DELETE FROM job WHERE key = #{key}
  </delete>

  <select id="search" resultMap="jobResultMap">
    SELECT <include refid="SELECT"/>
    FROM <include refid="FROM"/>
    <include refid="WHERE"/>
    ORDER BY j.created DESC
    <include refid="life.catalogue.db.Common.limit"/>
  </select>

  <select id="count" resultType="integer">
    SELECT count(*)
    FROM <include refid="FROM"/>
    <include refid="WHERE"/>
  </select>

  <select id="listStale" resultMap="jobResultMap">
    SELECT <include refid="SELECT"/>
    FROM <include refid="FROM"/>
    WHERE j.status IN ('WAITING','BLOCKED','RUNNING')
  </select>

  <update id="cancelStale">
    UPDATE job
    SET status = 'CANCELED'::JOBSTATUS, finished = now()
    WHERE status IN ('WAITING','BLOCKED','RUNNING')
  </update>

</mapper>
