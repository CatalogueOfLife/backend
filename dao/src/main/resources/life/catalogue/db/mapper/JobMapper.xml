<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="life.catalogue.db.mapper.JobMapper">

  <sql id="SELECT">
    j.key,
    j.job_class,
    j.lane,
    j.status,
    j.step,
    j.priority,
    j.dataset_key,
    j.sector_key,
    j.attempt,
    j.created_by,
    j.created,
    j.started,
    j.finished,
    j.error,
    j.params,
    j.result_md5,
    j.result_size,
    j.result_deleted
  </sql>

  <sql id="COLS">
    key,
    job_class,
    lane,
    status,
    step,
    priority,
    dataset_key,
    sector_key,
    attempt,
    created_by,
    created,
    started,
    finished,
    error,
    params,
    result_md5,
    result_size,
    result_deleted
  </sql>

  <sql id="PROPS">
    #{key},
    #{job},
    #{lane}::JOBLANE,
    #{status}::JOBSTATUS,
    #{step},
    #{priority}::JOBPRIORITY,
    #{datasetKey},
    #{sectorKey},
    #{attempt},
    #{createdBy},
    #{created},
    #{started},
    #{finished},
    #{error},
    #{params, typeHandler=life.catalogue.db.type2.JsonNodeHandler}::jsonb,
    #{resultMd5},
    #{resultSize},
    #{resultDeleted}
  </sql>

  <sql id="FROM">
    job j
  </sql>

  <sql id="WHERE">
    <where>
      <if test="req.key != null">AND j.key = #{req.key}</if>
      <if test="req.datasetKey != null">AND j.dataset_key = #{req.datasetKey}</if>
      <if test="req.sectorKey != null">AND j.sector_key = #{req.sectorKey}</if>
      <if test="req.createdBy != null">AND j.created_by = #{req.createdBy}</if>
      <if test="req.priority != null">AND j.priority = #{req.priority}::JOBPRIORITY</if>
      <if test="req.createdAfter != null">AND j.created &gt;= #{req.createdAfter}</if>
      <if test="req.createdBefore != null">AND j.created &lt;= #{req.createdBefore}</if>
      <!-- matches the lower(job_class) index -->
      <if test="req.job != null and !req.job.isEmpty()">
        AND lower(j.job_class) IN <foreach item="jc" collection="req.job" open="(" separator="," close=")">lower(#{jc})</foreach>
      </if>
      <if test="req.lane != null and !req.lane.isEmpty()">
        AND j.lane IN <foreach item="ln" collection="req.lane" open="(" separator="," close=")">#{ln}::JOBLANE</foreach>
      </if>
      <if test="req.status != null and !req.status.isEmpty()">
        AND j.status IN <foreach item="st" collection="req.status" open="(" separator="," close=")">#{st}::JOBSTATUS</foreach>
      </if>
      <!--
        Only imports and exports carry a data format and they keep it in their own satellite table -
        the source archive format for an import, the target format for an export. Filtering on it
        therefore also narrows the result to those two kinds of job. Both branches are keyed back to
        the job, so this stays a semi join and never duplicates rows.
        Neither format column is indexed - DATAFORMAT has too few values to be worth it - so the
        import branch costs one scan of dataset_import, hashed once per query.
      -->
      <if test="req.format != null">
        AND j.key IN (
          SELECT di.job_key FROM dataset_import di WHERE di.job_key IS NOT NULL AND di.format = #{req.format}::DATAFORMAT
          UNION ALL
          SELECT de.key FROM dataset_export de WHERE de.format = #{req.format}::DATAFORMAT
        )
      </if>
      <!--
        An import whose source was unchanged deletes its own dataset_import row again, so the absence of
        that row is what identifies it - not the step, which is free text and has read 'unchanged',
        'downloading' and null for the very same outcome over time. Only ImportJob runs in the IMPORT
        lane and dataset_import(job_key) is indexed, so this is a cheap anti join on top of the
        (lane, created) index. All three columns are NOT NULL, so the negated form has no null trap.
      -->
      <if test="req.unchanged != null">
        AND <if test="!req.unchanged">NOT</if> (
          j.lane = 'IMPORT'::JOBLANE AND j.status = 'FINISHED'::JOBSTATUS
          AND NOT EXISTS (SELECT 1 FROM dataset_import di WHERE di.job_key = j.key)
        )
      </if>
    </where>
  </sql>

  <resultMap id="jobResultMap" type="JobInfo" autoMapping="true">
    <id property="key" column="key"/>
    <result property="job" column="job_class"/>
    <result property="params" column="params" typeHandler="life.catalogue.db.type2.JsonNodeHandler"/>
  </resultMap>


  <select id="get" resultMap="jobResultMap">
    SELECT <include refid="SELECT"/>
    FROM <include refid="FROM"/>
    WHERE key = #{key}
  </select>

  <select id="exists" resultType="boolean">
    SELECT exists(
      SELECT TRUE FROM job WHERE key = #{key}
    )
  </select>

  <insert id="create" parameterType="JobInfo">
    INSERT INTO job (<include refid="COLS"/>)
    VALUES (<include refid="PROPS"/>)
  </insert>

  <!--
    attempt and params are updatable, not just inserted. A sector sync knows its attempt from its constructor,
    but an import or a release only creates its metrics record - and a release its new dataset - once it has
    started, so both are completed while the job runs. The other jobs keep their submitted request unchanged,
    rewriting a small jsonb on each step change.
    job_class, lane, priority, dataset_key, sector_key, created_by and created never change after insert.
  -->
  <update id="update" parameterType="JobInfo">
    UPDATE job
    SET (status, step, attempt, started, finished, error, params, result_md5, result_size, result_deleted)
      = (#{status}::JOBSTATUS, #{step}, #{attempt}, #{started}, #{finished}, #{error},
         #{params, typeHandler=life.catalogue.db.type2.JsonNodeHandler}::jsonb,
         #{resultMd5}, #{resultSize}, #{resultDeleted})
    WHERE key = #{key}
  </update>

  <delete id="delete">
    DELETE FROM job WHERE key = #{key}
  </delete>

  <select id="search" resultMap="jobResultMap">
    SELECT <include refid="SELECT"/>
    FROM <include refid="FROM"/>
    <include refid="WHERE"/>
    ORDER BY j.created DESC
    <include refid="life.catalogue.db.Common.limit"/>
  </select>

  <select id="count" resultType="integer">
    SELECT count(*)
    FROM <include refid="FROM"/>
    <include refid="WHERE"/>
  </select>

  <select id="listStale" resultMap="jobResultMap">
    SELECT <include refid="SELECT"/>
    FROM <include refid="FROM"/>
    WHERE j.status IN ('WAITING','BLOCKED','RUNNING')
  </select>

  <!--
    Periodic cleanup of the job history.

    A job row is the identity of the metrics that point at it: dataset_export INNER joins job, and
    dataset_import/sector_import read their status, step, job class and error from it. Deleting a job row
    out from under any of them would make an export disappear from the API and leave an import or sync
    attempt with a null status. The three NOT EXISTS below are the whole safety property, and they are
    deliberately expressed against the tables rather than a list of job class names, which would drift as
    soon as a new job type starts writing metrics.

    Only finished jobs are candidates - a WAITING, BLOCKED or RUNNING row belongs to a live job whatever
    its created date says. Within a class the newest keepPerClass rows are kept regardless of age, so a job
    type that last ran a year ago is still inspectable. row_number() therefore ranks over all finished jobs
    of the class, not just the deletable ones.

    LIMIT is applied after every filter, so one call deletes exactly min(limit, remaining) rows and the
    caller can loop until it returns less than limit. Filtering after the LIMIT would silently stall that
    loop on the first batch that happened to be full of pinned rows.
  -->
  <select id="deleteOld" resultType="java.util.UUID">
    DELETE FROM job j
    USING (
      SELECT key FROM (
        SELECT j2.key,
               j2.created,
               row_number() OVER (PARTITION BY j2.job_class ORDER BY j2.created DESC) AS rn,
               <choose>
                 <when test="overrides != null and !overrides.isEmpty()">
                   CASE lower(j2.job_class)
                     <foreach item="d" index="cl" collection="overrides">
                       WHEN lower(#{cl}) THEN #{d}
                     </foreach>
                     ELSE #{defaultDays}
                   END AS max_days
                 </when>
                 <otherwise>
                   #{defaultDays} AS max_days
                 </otherwise>
               </choose>
        FROM job j2
        WHERE j2.status IN ('FINISHED','CANCELED','FAILED')
      ) ranked
      WHERE rn &gt; #{keepPerClass}
        AND created &lt; now() - (max_days || ' days')::interval
        AND NOT EXISTS (SELECT 1 FROM dataset_import di WHERE di.job_key = ranked.key)
        AND NOT EXISTS (SELECT 1 FROM sector_import si WHERE si.job_key = ranked.key)
        AND NOT EXISTS (SELECT 1 FROM dataset_export de WHERE de.key = ranked.key)
      LIMIT #{limit}
    ) doomed
    WHERE j.key = doomed.key
    -- returning the keys lets JobCleanup delete the job logs of exactly the rows it reaped.
    -- one statement, so there is never a window where a row is gone but its key unknown.
    RETURNING j.key
  </select>

  <update id="cancelStale">
    UPDATE job
    SET status = 'CANCELED'::JOBSTATUS, finished = now()
    WHERE status IN ('WAITING','BLOCKED','RUNNING')
  </update>

</mapper>
