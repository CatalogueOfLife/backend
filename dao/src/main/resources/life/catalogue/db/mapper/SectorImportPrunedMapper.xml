<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="life.catalogue.db.mapper.SectorImportPrunedMapper">

  <resultMap id="prunedResultMap" type="life.catalogue.db.mapper.SectorImportPrunedMapper$PrunedAttempt" autoMapping="true"/>

  <!-- the table only exists between the job migration and the sweep, so everything else is guarded by this -->
  <select id="tableExists" resultType="boolean">
    SELECT to_regclass('public.sector_import_pruned') IS NOT NULL
  </select>

  <select id="count" resultType="integer">
    SELECT count(*) FROM sector_import_pruned
  </select>

  <select id="list" resultMap="prunedResultMap">
    SELECT dataset_key, sector_key, attempt
    FROM sector_import_pruned
    <if test="after != null">
      WHERE (dataset_key, sector_key, attempt) &gt; (#{after.datasetKey}, #{after.sectorKey}, #{after.attempt})
    </if>
    ORDER BY dataset_key, sector_key, attempt
    LIMIT #{limit}
  </select>

  <!-- the page just swept, in the same order list() returns -->
  <delete id="deleteUpTo">
    DELETE FROM sector_import_pruned
    WHERE (dataset_key, sector_key, attempt) &lt;= (#{last.datasetKey}, #{last.sectorKey}, #{last.attempt})
  </delete>

</mapper>
