<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="life.catalogue.db.mapper.SectorMetadataMapper">

  <!--
  The human metadata column list lives once, in DatasetPatchMapper. sector_metadata is a LIKE clone of
  dataset_patch minus its key and plus sector_id + doi, so SELECT_NO_KEY / COLS / PROPS are reused
  verbatim and cannot drift.
  -->
  <sql id="SELECT">
    d.dataset_key,
    d.sector_id,
    d.doi,
    <include refid="life.catalogue.db.mapper.DatasetPatchMapper.SELECT_NO_KEY"/>
  </sql>

  <!--
  Deliberately NOT DatasetMapper.datasetResultMap: that one keys on d.key, which this table does not
  have, and its source collection reads dataset_citation rather than sector_citation.
  -->
  <resultMap id="sectorMetadataResultMap" type="Dataset" autoMapping="true">
    <!--
    No <id> mapping on purpose. Dataset.key is a DATASET key and this row describes a sector, so
    binding it to sector_id would hand every caller of getKey() a wrong dataset key. Nested selects
    do not need an id to group by, and the caller already knows which sector it asked for.
    -->
    <result property="contact" column="contact" typeHandler="life.catalogue.db.type.AgentTypeHandler"/>
    <result property="creator" column="creator" typeHandler="life.catalogue.db.type.AgentArrayTypeHandler"/>
    <result property="editor" column="editor" typeHandler="life.catalogue.db.type.AgentArrayTypeHandler"/>
    <result property="publisher" column="publisher" typeHandler="life.catalogue.db.type.AgentTypeHandler"/>
    <result property="contributor" column="contributor" typeHandler="life.catalogue.db.type.AgentArrayTypeHandler"/>
    <result property="identifier" column="identifier" typeHandler="life.catalogue.db.type2.IdentifierArrayTypeHandler"/>
    <result property="urlFormatter" column="url_formatter" typeHandler="life.catalogue.db.type2.HstoreMapTypeHandler"/>
    <result property="taxonomicGroupScope" column="taxonomic_group_scope" typeHandler="life.catalogue.db.type2.TaxGroupSetTypeHandler"/>
    <association property="conversion" javaType="life.catalogue.api.model.Dataset$UrlDescription">
      <result property="url" column="conversion_url" />
      <result property="description" column="conversion_description" />
    </association>
    <collection property="source" ofType="Citation" column="{datasetKey=dataset_key,sectorId=sector_id}"
                select="life.catalogue.db.mapper.CitationMapper.listSector" />
  </resultMap>

  <select id="get" resultMap="sectorMetadataResultMap">
    SELECT <include refid="SELECT"/>
    FROM sector_metadata d
    WHERE d.dataset_key = #{key.datasetKey} AND d.sector_id = #{key.id}
  </select>

  <select id="listSectorIds" resultType="integer">
    SELECT sector_id FROM sector_metadata WHERE dataset_key = #{datasetKey} ORDER BY sector_id
  </select>

  <!--
  created_by / modified_by are NOT NULL with no default: LIKE does not copy defaults, and COLS excludes
  created_by on purpose. Both have to be written explicitly here.
  -->
  <insert id="create" parameterType="map" useGeneratedKeys="false">
    INSERT INTO sector_metadata (dataset_key, sector_id, doi, <include refid="life.catalogue.db.mapper.DatasetPatchMapper.COLS"/>, created_by, created, modified)
    VALUES (#{key.datasetKey}, #{key.id}, #{obj.doi, typeHandler=life.catalogue.db.type.DoiTypeHandler}, <include refid="life.catalogue.db.mapper.DatasetPatchMapper.PROPS"/>, #{obj.createdBy}, now(), now())
  </insert>

  <update id="update" parameterType="map">
    UPDATE sector_metadata
    SET (doi, <include refid="life.catalogue.db.mapper.DatasetPatchMapper.COLS"/>, modified)
    = (#{obj.doi, typeHandler=life.catalogue.db.type.DoiTypeHandler}, <include refid="life.catalogue.db.mapper.DatasetPatchMapper.PROPS"/>, now())
    WHERE dataset_key = #{key.datasetKey} AND sector_id = #{key.id}
  </update>

  <delete id="delete" parameterType="map">
    DELETE FROM sector_metadata
    WHERE dataset_key = #{key.datasetKey} AND sector_id = #{key.id}
  </delete>

  <select id="listSectorIdsToFreeze" resultType="integer">
    SELECT s.id FROM sector s
    WHERE s.dataset_key = #{datasetKey}
      AND (
        s.subject_sector_id IS NOT NULL
        OR EXISTS (SELECT TRUE FROM sector_metadata m WHERE m.dataset_key = #{projectKey} AND m.sector_id = s.id)
      )
    ORDER BY s.id
  </select>

  <delete id="deleteByDataset" parameterType="map">
    DELETE FROM sector_metadata WHERE dataset_key = #{datasetKey}
  </delete>

</mapper>
