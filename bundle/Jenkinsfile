// Builds the data artifact of a CLB release-in-a-box bundle and publishes it to the download host.
//
// Run it with a single argument, the release key:
//
//   builds.gbif.org/view/COL/job/col-bundle/buildWithParameters?token=<job token>&RELEASE_KEY=3287
//
// The heavy lifting happens on the prod apps VM, not on the agent: bundleBuild needs the live config,
// network access to the production postgres, rights to create a temporary database there, pg_dump
// and tens of GB of scratch, and it writes straight into the download directory. All of that already
// exists on the apps VM, so this pipeline only drives deploy/bundle.sh over ssh and reports back.
//
// It reaches the VM the way the col-portal and col-blixa jobs do: the Jenkins user's own ssh key is
// authorized as jenkins-deploy, which may run anything as col (/etc/sudoers.d/jenkins-deploy-col), and
// the deploy repo is checked out as col in /home/col/bin. There is deliberately no host or credential
// parameter: a declarative parameters block replaces the job's parameter definitions on every run, so
// defaults set in the job configuration are wiped by the next build.
//
// A job that has never run has no parameters yet, so its first build fails validation - after that
// "Build with Parameters" and buildWithParameters work.
pipeline {
  agent any
  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    skipDefaultCheckout(true)
    timestamps()
    timeout(time: 12, unit: 'HOURS')
  }
  parameters {
    string(name: 'RELEASE_KEY', defaultValue: '', description: 'Key of the release to bundle. The only argument you need.')
    string(name: 'IMAGE', defaultValue: 'ghcr.io/catalogueoflife/clb-bundle:latest',
           description: 'App image the generated docker-compose.yml pulls')
    booleanParam(name: 'KEEP_WORKDIR', defaultValue: false, description: 'Keep the uncompressed build directory on the VM')
  }
  environment {
    DEPLOY_HOST = 'apps.checklistbank.org'
    DEPLOY_USER = 'jenkins-deploy'
    DEPLOY_DIR = '/home/col/bin'
  }

  stages {
    stage('Validate') {
      steps {
        script {
          if (!params.RELEASE_KEY?.isInteger()) {
            error("RELEASE_KEY must be an integer dataset key, got '${params.RELEASE_KEY}'")
          }
          if (!(params.IMAGE ==~ /[A-Za-z0-9._\/:@-]+/)) {
            error("IMAGE is not a docker image reference: '${params.IMAGE}'")
          }
          currentBuild.displayName = "#${BUILD_NUMBER} release ${params.RELEASE_KEY}"
        }
      }
    }

    stage('Update deploy scripts') {
      steps {
        sh '''
          ssh -o StrictHostKeyChecking=accept-new ${DEPLOY_USER}@${DEPLOY_HOST} \
            "sudo -u col git -C ${DEPLOY_DIR} pull --ff-only"
        '''
      }
    }

    stage('Build bundle') {
      steps {
        // bundle.sh sources functions.sh and reads cli-jvm.args from its working dir, and needs col's
        // login PATH for java, yq and pg_dump. The keepalive holds the session open through the hours
        // long COPY and pg_dump phases, which print nothing.
        sh """
          ssh -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=60 ${DEPLOY_USER}@${DEPLOY_HOST} \\
            "sudo -iu col zsh -c 'cd ${DEPLOY_DIR} && ./bundle.sh --key ${params.RELEASE_KEY} --image ${params.IMAGE} ${params.KEEP_WORKDIR ? '--keep' : ''}'"
        """
      }
    }

    stage('Verify published') {
      steps {
        // bundle.sh prints the published paths; re-check them from the VM so a silent failure
        // to move the files into place cannot pass as success
        sh """
          ssh -o StrictHostKeyChecking=accept-new ${DEPLOY_USER}@${DEPLOY_HOST} \\
            "sudo -iu col zsh -c 'cd ${DEPLOY_DIR} && ./bundle.sh --key ${params.RELEASE_KEY} --verify-only'"
        """
      }
    }
  }

  post {
    success { echo "Bundle for release ${params.RELEASE_KEY} published." }
    failure { echo "Bundle build for release ${params.RELEASE_KEY} FAILED." }
  }
}
